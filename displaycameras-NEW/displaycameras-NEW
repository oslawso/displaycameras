#!/bin/bash
### BEGIN INIT INFO
# Provides: displaycameras-NEW
# Required-Start: $network $local_fs cron
# Required-Stop:
# Default-Start: 2 3 4 5
# Default-Stop: 0 1 6
# Short-Description: Displays camera feeds for monitoring using mpv
# Description: Modern replacement for displaycameras using mpv instead of omxplayer
### END INIT INFO

#version:1.0.0

# Exit if not root
if [[ $EUID -ne 0 ]]; then
   echo "This script must be run as root"
   exit 0
fi

# Exit if mpv_control is not executable and in the PATH
if [ ! "$(which mpv_control)" ]; then
    echo "mpv_control must be executable and in the PATH env variable."
    exit 1
fi

# Exit if mpv is not installed
if [ ! "$(which mpv)" ]; then
    echo "Please install mpv: apt-get install mpv"
    exit 1
fi

# Exit if socat is not installed
if [ ! "$(which socat)" ]; then
    echo "Please install socat: apt-get install socat"
    exit 1
fi

# Exit if config file is not present and readable
if [ -r /etc/displaycameras-NEW/displaycameras-NEW.conf ]; then
    . /etc/displaycameras-NEW/displaycameras-NEW.conf
else
    echo "/etc/displaycameras-NEW/displaycameras-NEW.conf does not exist or is not readable."
    exit 1
fi

# Exit if default layout config file is not present and readable
if [ ! -r /etc/displaycameras-NEW/layout.conf.default ]; then
    echo "/etc/displaycameras-NEW/layout.conf.default does not exist or is not readable."
    exit 1
fi

# If enabled, autodetect display mode, check for layout config file for that
# mode, and load that file if present.
if [ "$displaydetect" = "true" ]; then
    mode=""
    # Try xrandr first (X11)
    if command -v xrandr &>/dev/null; then
        mode=$(xrandr 2>/dev/null | grep '\*' | head -1 | awk '{print $1}')
    fi
    # Fallback to fbset
    if [ -z "$mode" ] && command -v fbset &>/dev/null; then
        if [ "$(grep disable_overscan /boot/config.txt 2>/dev/null | grep -v ^#)" = "disable_overscan=1" ]; then
            mode=$(fbset -s 2>/dev/null | grep '^mode' | awk '{print $2}' | tr -d '"')
        else
            echo "Display resolution autodetection will not work properly with overscan enabled."
            echo "Ensure disable_overscan=1 is in /boot/config.txt."
        fi
    fi
    # Fallback to wlr-randr (Wayland)
    if [ -z "$mode" ] && command -v wlr-randr &>/dev/null; then
        mode=$(wlr-randr 2>/dev/null | grep 'current' | head -1 | awk '{print $1}')
    fi

    if [ -n "$mode" ] && [ -r "/etc/displaycameras-NEW/layout.conf.$mode" ]; then
        . "/etc/displaycameras-NEW/layout.conf.$mode"
        displaydetectactive=true
    else
        . /etc/displaycameras-NEW/layout.conf.default
        if [ -n "$mode" ]; then
            echo "No layout configuration file found for $mode resolution."
        fi
    fi
else
    . /etc/displaycameras-NEW/layout.conf.default
fi

# Ensure there is an mpv timeout value
if [ -z "$mpv_timeout" ]; then
    mpv_timeout=30
fi

# Ensure there are startup timing values
if [ -z "$startsleep" ]; then
    startsleep=3
fi
if [ -z "$feedsleep" ]; then
    feedsleep=1
fi
if [ -z "$retry" ]; then
    retry=5
fi

# Hardware acceleration mode
if [ -z "$hwdec" ]; then
    hwdec=auto
fi

# Set variables for PID file and Display Sequence file
PIDFILE=/var/run/displaycameras-NEW.pid
DISPLAY_SEQUENCE_FILE=/tmp/displaycameras-NEW.seq

# How many cameras do we have?
cameras="${#camera_names[@]}"
# Set the max camera rotation sequence as one less than the number of cameras
max_seq=$((cameras-1))
# Ensure sequence step value is reasonable
if [ -z "$seq_step" ] || [ "$seq_step" -gt "$max_seq" ] || [ "$seq_step" -lt "1" ]; then
    seq_step=1
fi

# Figure out the current display sequence or set it to zero if it doesn't exist.
if [ ! -f "$DISPLAY_SEQUENCE_FILE" ]; then
    echo 0 > "$DISPLAY_SEQUENCE_FILE"
fi
declare -i DISPLAY_SEQUENCE
DISPLAY_SEQUENCE=$(cat "$DISPLAY_SEQUENCE_FILE")

# Convert "x1 y1 x2 y2" to mpv geometry "WxH+X+Y"
convert_position_to_geometry() {
    local pos="$1"
    local x1 y1 x2 y2 w h
    x1=$(echo "$pos" | awk '{print $1}')
    y1=$(echo "$pos" | awk '{print $2}')
    x2=$(echo "$pos" | awk '{print $3}')
    y2=$(echo "$pos" | awk '{print $4}')
    w=$((x2 - x1 + 1))
    h=$((y2 - y1 + 1))
    echo "${w}x${h}+${x1}+${y1}"
}

# Launch an mpv instance for a camera
launch_player() {
    local camera_name="$1"
    local feed_url="$2"
    local geometry="$3"
    local socket="/tmp/mpv-ipc-${camera_name}.sock"

    # Remove stale socket if exists
    rm -f "$socket"

    # Build mpv command with appropriate options
    local mpv_opts="--no-terminal --no-osc --no-border --ontop"
    mpv_opts="$mpv_opts --no-input-default-bindings --no-osd-bar"
    mpv_opts="$mpv_opts --hwdec=$hwdec"

    # Add low-latency profile for live streams if enabled
    if [ "$low_latency" = "true" ]; then
        mpv_opts="$mpv_opts --profile=low-latency"
    fi

    mpv_opts="$mpv_opts --rtsp-transport=tcp"
    mpv_opts="$mpv_opts --network-timeout=$mpv_timeout"
    mpv_opts="$mpv_opts --geometry=$geometry"
    mpv_opts="$mpv_opts --input-ipc-server=$socket"
    mpv_opts="$mpv_opts --force-window=immediate"
    mpv_opts="$mpv_opts --keep-open=no"
    mpv_opts="$mpv_opts --idle=no"

    # Launch mpv in background
    mpv $mpv_opts "$feed_url" >/dev/null 2>&1 &
}

case "$1" in
# Start displaying camera feeds
start)
    if [ -f "$PIDFILE" ]; then
        echo "PID file exists! Stop or Restart this service instead."
        exit 1
    fi

    if [ "$blank" = "true" ]; then
        echo "Blanking screen"
        fbi --noverbose -T 2 /usr/bin/black.png >/dev/null 2>&1 &
    fi

    if [ "$displaydetectactive" = "true" ]; then
        echo "Display detection is active for $mode resolution."
    fi

    startupfailure=false
    feedfailure=false

    for i in "${!camera_names[@]}"; do
        startupretry=0
        feedretry=0
        x=$((i + DISPLAY_SEQUENCE))
        if [ "$x" -ge "${#camera_names[@]}" ]; then
            x=$((x - ${#camera_names[@]}))
        fi

        # Convert position to geometry
        geometry=$(convert_position_to_geometry "${window_positions[$x]}")

        echo "Starting mpv for ${camera_names[$i]}"
        launch_player "${camera_names[$i]}" "${camera_feeds[$i]}" "$geometry"

        sleep "$startsleep"

        # Wait for playback to start
        while [ "$(mpv_control "${camera_names[$i]}" getplaystatus 2>/dev/null)" != "Playing" ]; do
            sleep 1
            echo "Waiting for ${camera_names[$i]} mpv startup $startupretry"
            if [ "$startupretry" -eq "$retry" ]; then
                break
            fi
            startupretry=$((startupretry + 1))
        done

        if [ "$(mpv_control "${camera_names[$i]}" getplaystatus 2>/dev/null)" = "Playing" ]; then
            sleep "$feedsleep"
            # Wait for actual playback (position > 0)
            while [ "$(mpv_control "${camera_names[$i]}" getposition 2>/dev/null)" = "0s" ]; do
                sleep 1
                echo "Waiting for ${camera_names[$i]} playback $feedretry"
                if [ "$feedretry" -eq "$retry" ]; then
                    mpv_control "${camera_names[$i]}" quit 2>/dev/null
                    feedfailure=true
                    break
                fi
                feedretry=$((feedretry + 1))
            done
        else
            startupfailure=true
        fi

        if [ "$(mpv_control "${camera_names[$i]}" getplaystatus 2>/dev/null)" = "Playing" ] && \
           [ "$(mpv_control "${camera_names[$i]}" getposition 2>/dev/null)" != "0s" ]; then
            echo "${camera_names[$i]} started"
        else
            echo "${camera_names[$i]} failed playback"
        fi
    done

    touch "$PIDFILE"

    # One go at a repair job if not all displays start correctly
    if [ "$startupfailure" = "true" ] || [ "$feedfailure" = "true" ]; then
        echo "Running a repair on failed feeds."
        "$0" repair startup
    fi

    echo "Camera Display Started"
    echo "For complete status info, run"
    echo "/usr/bin/displaycameras-NEW status."

    if [ "$rotate" = "true" ]; then
        if [ -z "$rotatedelay" ]; then
            rotatedelay=5
        fi
        echo "Starting camera rotation"
        rotatedisplays-NEW "$rotatedelay" "$seq_step" &
    fi
    ;;

# Stop displaying camera feeds
stop)
    rm -f "$PIDFILE"
    rm -f "$DISPLAY_SEQUENCE_FILE"

    if [ "$rotate" = "true" ]; then
        pkill -f rotatedisplays-NEW
    fi

    for i in "${camera_names[@]}"; do
        mpv_control "$i" quit 2>/dev/null
    done

    sleep 2

    if [ "$blank" = "true" ]; then
        pkill fbi
    fi

    # Force kill any remaining mpv instances started by this service
    pkill -f "mpv.*mpv-ipc-" 2>/dev/null

    # Clean up sockets
    rm -f /tmp/mpv-ipc-*.sock 2>/dev/null

    echo "Camera Display Stopped"
    exit 0
    ;;

# Restart
restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;

# Restart any camera feeds that don't claim to be playing or restart the service
# if too many mpv instances are active.
repair)
    # Do nothing unless the service PID file exists
    if [ ! -f "$PIDFILE" ]; then
        exit 0
    fi

    # Stop and start the service if we have too many mpv instances
    mpv_count=$(pgrep -c -f "mpv.*mpv-ipc-" 2>/dev/null || echo 0)
    if [ "$mpv_count" -gt "$cameras" ]; then
        "$0" restart
        exit 0
    fi

    # The actual repair part
    for i in "${!camera_names[@]}"; do
        playstatus=$(mpv_control "${camera_names[$i]}" getplaystatus 2>/dev/null)
        position=$(mpv_control "${camera_names[$i]}" getposition 2>/dev/null)

        if [ "$playstatus" != "Playing" ] || [ "$position" = "0s" ]; then
            rm -f "$PIDFILE"
            pkill -f rotatedisplays-NEW 2>/dev/null

            mpv_control "${camera_names[$i]}" quit 2>/dev/null

            x=$((i + DISPLAY_SEQUENCE))
            if [ "$x" -ge "${#camera_names[@]}" ]; then
                x=$((x - ${#camera_names[@]}))
            fi

            geometry=$(convert_position_to_geometry "${window_positions[$x]}")

            echo "Starting mpv for ${camera_names[$i]}"
            launch_player "${camera_names[$i]}" "${camera_feeds[$i]}" "$geometry"

            sleep "$startsleep"

            startupretry=0
            feedretry=0

            while [ "$(mpv_control "${camera_names[$i]}" getplaystatus 2>/dev/null)" != "Playing" ]; do
                sleep 1
                echo "Waiting for ${camera_names[$i]} mpv startup $startupretry"
                if [ "$startupretry" -eq "$retry" ]; then
                    break
                fi
                startupretry=$((startupretry + 1))
            done

            if [ "$(mpv_control "${camera_names[$i]}" getplaystatus 2>/dev/null)" = "Playing" ]; then
                sleep "$feedsleep"
                while [ "$(mpv_control "${camera_names[$i]}" getposition 2>/dev/null)" = "0s" ]; do
                    sleep 1
                    echo "Waiting for ${camera_names[$i]} playback $feedretry"
                    if [ "$feedretry" -eq "$retry" ]; then
                        mpv_control "${camera_names[$i]}" quit 2>/dev/null
                        break
                    fi
                    feedretry=$((feedretry + 1))
                done
            fi

            if [ "$(mpv_control "${camera_names[$i]}" getplaystatus 2>/dev/null)" = "Playing" ] && \
               [ "$(mpv_control "${camera_names[$i]}" getposition 2>/dev/null)" != "0s" ]; then
                echo "${camera_names[$i]} started"
            else
                echo "${camera_names[$i]} failed playback"
            fi

            touch "$PIDFILE"

            if [ "$rotate" = "true" ]; then
                if [ -z "$rotatedelay" ]; then
                    rotatedelay=5
                fi
                if [ "$2" != "startup" ]; then
                    echo "Restarting camera rotation"
                    rotatedisplays-NEW "$rotatedelay" "$seq_step" &
                fi
            fi
        fi
    done
    ;;

rotate)
    # Do nothing unless the service PID file exists
    if [ ! -f "$PIDFILE" ]; then
        exit 0
    fi

    DISPLAY_SEQUENCE=$((DISPLAY_SEQUENCE - seq_step))
    if [ "$DISPLAY_SEQUENCE" -lt "0" ]; then
        DISPLAY_SEQUENCE="$max_seq"
    fi

    for i in "${!camera_names[@]}"; do
        y=$((i - DISPLAY_SEQUENCE - 1))
        if [ "$y" -lt "0" ]; then
            y=$((y + ${#camera_names[@]}))
        fi
        if [ "$y" -ge "${#camera_names[@]}" ]; then
            y=$((y - ${#camera_names[@]}))
        fi
        x=$((y + DISPLAY_SEQUENCE))
        if [ "$x" -ge "${#camera_names[@]}" ]; then
            x=$((x - ${#camera_names[@]}))
        fi
        mpv_control "${camera_names[$y]}" setvideopos "${window_positions[$x]}"
    done

    echo "$DISPLAY_SEQUENCE" > "$DISPLAY_SEQUENCE_FILE"
    ;;

rotaterev)
    if [ ! -f "$PIDFILE" ]; then
        exit 0
    fi

    DISPLAY_SEQUENCE=$((DISPLAY_SEQUENCE + seq_step))
    if [ "$DISPLAY_SEQUENCE" -ge "${#camera_names[@]}" ]; then
        DISPLAY_SEQUENCE=0
    fi

    for i in "${!camera_names[@]}"; do
        y=$((i - DISPLAY_SEQUENCE + 1))
        if [ "$y" -lt "0" ]; then
            y=$((y + ${#camera_names[@]}))
        fi
        if [ "$y" -ge "${#camera_names[@]}" ]; then
            y=$((y - ${#camera_names[@]}))
        fi
        x=$((y + DISPLAY_SEQUENCE))
        if [ "$x" -ge "${#camera_names[@]}" ]; then
            x=$((x - ${#camera_names[@]}))
        fi
        mpv_control "${camera_names[$y]}" setvideopos "${window_positions[$x]}"
    done

    echo "$DISPLAY_SEQUENCE" > "$DISPLAY_SEQUENCE_FILE"
    ;;

status)
    for i in "${camera_names[@]}"; do
        status=$(mpv_control "$i" status 2>/dev/null)
        if [[ "$status" != "Playing"* ]]; then
            echo "$i is NOT playing"
        else
            echo "$i is $status"
        fi
    done
    ;;

positions)
    for i in "${camera_names[@]}"; do
        position=$(mpv_control "$i" getposition 2>/dev/null)
        echo "$position $i"
    done
    ;;

*)
    echo "Usage: /usr/bin/displaycameras-NEW {start|stop|restart|repair|status|positions|rotate|rotaterev}"
    exit 1
    ;;
esac
